   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"SPLETNA", " ", "APLIKACIJA"}], "*)"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"spletnaAplikacija", "=", 
    RowBox[{"FormPage", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Mesto\>\"", "->", "\"\<City\>\""}], "}"}], ",", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "imeMesta", ",", "ts", ",", "vsiTs", ",", "povprecjeSlo", ",", 
