Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", "PARAMETi", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"kraji", "=", 
     RowBox[{"{", 
      RowBox[{
      "\"\<Ljubljana\>\"", ",", "\"\<Maribor\>\"", ",", "\"\<Koper\>\"", ",", 
       "\"\<Kranjska Gora\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"toplotnaIzguba", "=", "220"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"W", "/", "K"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"notranjeTemperature", "=", 
     RowBox[{"{", 
      RowBox[{"18", ",", "20", ",", "22"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"zacetniDatum", "=", 
     RowBox[{"DateObject", "[", 
      RowBox[{"{", 
       RowBox[{"2024", ",", "10", ",", "1"}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"koncniDatum", "=", 
     RowBox[{"DateObject", "[", 
      RowBox[{"{", 
       RowBox[{"2025", ",", "4", ",", "30"}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"PRIDOBIVANJE", " ", "PODATKOV"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"pridobiDnevneTemperature", "[", "kraj_", "]"}], ":=", 
     RowBox[{
      RowBox[{"pridobiDnevneTemperature", "[", "kraj", "]"}], "=", 
      RowBox[{"QuantityMagnitude", "[", 
       RowBox[{"DeleteMissing", "[", 
        RowBox[{"WeatherData", "[", 
         RowBox[{"kraj", ",", "\"\<MeanTemperature\>\"", ",", 
          RowBox[{"{", 
           RowBox[{"zacetniDatum", ",", "koncniDatum", ",", "\"\<Day\>\""}], 
           "}"}]}], "]"}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"PORABA", " ", "ENERGIJE"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"temperaturniPrimanjkljaj", "[", 
      RowBox[{"seznam_", ",", "Tin_"}], "]"}], ":=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"Tin", "-", "#"}], ",", "0"}], "]"}], "&"}], ",", 
       "seznam"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"casovniPotekMoci", "[", 
      RowBox[{"kraj_", ",", "Tin_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "vremenskiPodatki", ",", "datumi", ",", "zunanjeTemp", ",", "dT", ",",
          "moc"}], "}"}], ",", 
       RowBox[{
        RowBox[{"vremenskiPodatki", "=", 
         RowBox[{"pridobiDnevneTemperature", "[", "kraj", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"datumi", "=", 
         RowBox[{"vremenskiPodatki", "[", "\"\<Dates\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"zunanjeTemp", "=", 
         RowBox[{"vremenskiPodatki", "[", "\"\<Values\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dT", "=", 
         RowBox[{"temperaturniPrimanjkljaj", "[", 
          RowBox[{"zunanjeTemp", ",", "Tin"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"moc", "=", 
         RowBox[{"toplotnaIzguba", "*", "dT"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"TimeSeries", "[", 
         RowBox[{"Thread", "[", 
          RowBox[{"{", 
           RowBox[{"datumi", ",", "moc"}], "}"}], "]"}], "]"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"porabaEnergije", "[", 
      RowBox[{"kraj_", ",", "Tin_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"seznamMoci", ",", "dnevnaEnergija"}], "}"}], ",", 
       RowBox[{
        RowBox[{"seznamMoci", "=", 
         RowBox[{
          RowBox[{"casovniPotekMoci", "[", 
           RowBox[{"kraj", ",", "Tin"}], "]"}], "[", "\"\<Values\>\"", 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"dnevnaEnergija", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"seznamMoci", "*", "24"}], ")"}], "/", "1000"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Total", "[", "dnevnaEnergija", "]"}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"ANALIZA", " ", "IN", " ", "GRAFI"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Graf", " ", "zunanje", " ", "temperature"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"DateListPlot", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{"pridobiDnevneTemperature", ",", "kraji"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotLegends", "->", "kraji"}], ",", "\[IndentingNewLine]", 
     RowBox[{
     "PlotLabel", "->", "\"\<Povpre\[CHacek]ne dnevne temperature\>\""}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Datum\>\"", ",", "\"\<T [\[Degree]C]\>\""}], "}"}]}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}]}], "]"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Grafi", " ", "mo\[CHacek]i", " ", "ogrevanja"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Column", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"DateListPlot", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"casovniPotekMoci", "[", 
            RowBox[{"#", ",", "T"}], "]"}], "&"}], ",", "kraji"}], "]"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"PlotLegends", "->", "kraji"}], ",", "\[IndentingNewLine]", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"\"\<Potrebna mo\[CHacek] ogrevanja (\>\"", "<>", 
          RowBox[{"ToString", "[", "T", "]"}], "<>", 
