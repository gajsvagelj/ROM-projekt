        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<Datum\>\"", ",", "\"\<P [W]\>\""}], "}"}]}], ",", 
        RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"ImageSize", "->", "500"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"T", ",", "notranjeTemperature"}], "}"}]}], "]"}], "]"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Skupna", " ", "poraba", " ", "energije"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Column", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"BarChart", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"porabaEnergije", "[", 
            RowBox[{"k", ",", "T"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "kraji"}], "}"}]}], "]"}], ",", 
