          RowBox[{"{", 
           RowBox[{
           "LightBlue", ",", "LightOrange", ",", "LightGreen", ",", 
            "LightPurple"}], "}"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"LabelingFunction", "->", "Above"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"ImageSize", "->", "500"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"T", ",", "notranjeTemperature"}], "}"}]}], "]"}], ",", 
     RowBox[{"Spacings", "->", "2"}]}], "]"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Odstotno", " ", "pove\[CHacek]anje", " ", "porabe", " ", "glede", " ", 
     "na", " ", "18", " ", "\[Degree]C"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"podatkiOdstotki", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"porabaEnergije", "[", 
              RowBox[{"k", ",", "20"}], "]"}], "-", 
             RowBox[{"porabaEnergije", "[", 
              RowBox[{"k", ",", "18"}], "]"}]}], ")"}], "/", 
           RowBox[{"porabaEnergije", "[", 
            RowBox[{"k", ",", "18"}], "]"}]}], "*", "100"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"porabaEnergije", "[", 
              RowBox[{"k", ",", "22"}], "]"}], "-", 
             RowBox[{"porabaEnergije", "[", 
              RowBox[{"k", ",", "18"}], "]"}]}], ")"}], "/", 
           RowBox[{"porabaEnergije", "[", 
            RowBox[{"k", ",", "18"}], "]"}]}], "*", "100"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"k", ",", "kraji"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"BarChart", "[", 
    RowBox[{"podatkiOdstotki", ",", "\[IndentingNewLine]", 
     RowBox[{"ChartLabels", "->", 
      RowBox[{"{", 
       RowBox[{"kraji", ",", "None"}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"ChartLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<20 \[Degree]C\>\"", ",", "\"\<22 \[Degree]C\>\""}], 
       "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
     "PlotLabel", "->", "\"\<Odstotno pove\[CHacek]anje porabe [%]\>\""}], 
     ",", "   ", "\[IndentingNewLine]", 
     RowBox[{"ChartStyle", "->", 
      RowBox[{"{", 
       RowBox[{"LightBlue", ",", "LightOrange"}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"LabelingFunction", "->", "Above"}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
