      RowBox[{"{", 
       RowBox[{"None", ",", 
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{"ToString", ",", "notranjeTemperature"}], "]"}], ",", 
