           ",", "grafOdstotkov", ",", "tabela"}], "}"}], ",", 
         RowBox[{
          RowBox[{"imeMesta", "=", 
           RowBox[{"CommonName", "[", "#Mesto", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"vremenskiPodatki", "=", 
           RowBox[{"pridobiDnevneTemperature", "[", "#Mesto", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Head", "[", "vremenskiPodatki", "]"}], "=!=", 
             "TimeSeries"}], ",", 
            RowBox[{
            "Return", "[", 
             "\"\< Podatkov za to mesto ni mogo\[CHacek]e najti.\>\"", 
             "]"}]}], "]"}], ";", 
          RowBox[{"podatkiVsehKrajev", "=", 
           RowBox[{"Map", "[", 
            RowBox[{"pridobiDnevneTemperature", ",", "kraji"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"povprecjeSlo", "=", 
           RowBox[{"TimeSeriesThread", "[", 
            RowBox[{"Mean", ",", "podatkiVsehKrajev"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"moc18", "=", 
           RowBox[{"casovniPotekMoci", "[", 
            RowBox[{"#Mesto", ",", "18"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"moc20", "=", 
           RowBox[{"casovniPotekMoci", "[", 
            RowBox[{"#Mesto", ",", "20"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"moc22", "=", 
           RowBox[{"casovniPotekMoci", "[", 
            RowBox[{"#Mesto", ",", "22"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"t18", "=", 
           RowBox[{"porabaEnergije", "[", 
            RowBox[{"#Mesto", ",", "18"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"t20", "=", 
           RowBox[{"porabaEnergije", "[", 
            RowBox[{"#Mesto", ",", "20"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"t22", "=", 
           RowBox[{"porabaEnergije", "[", 
            RowBox[{"#Mesto", ",", "22"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"grafTemp", "=", 
           RowBox[{"DateListPlot", "[", 
            RowBox[{"vremenskiPodatki", ",", 
             RowBox[{"PlotLabel", "->", "\"\<Zunanje temperature\>\""}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"grafPrimerjave", "=", 
           RowBox[{"DateListPlot", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"vremenskiPodatki", ",", "povprecjeSlo"}], "}"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"PlotLegends", "->", 
              RowBox[{"{", 
               RowBox[{
               "imeMesta", ",", "\"\<Slovensko povpre\[CHacek]je\>\""}], 
               "}"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{"PlotLabel", "->", "\"\<Primerjava temperatur\>\""}], 
             ",", "\[IndentingNewLine]", 
             RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"grafMoci", "=", 
           RowBox[{"DateListPlot", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"moc18", ",", "moc20", ",", "moc22"}], "}"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"PlotLegends", "->", 
              RowBox[{"{", 
               RowBox[{
               "\"\<18 \[Degree]C\>\"", ",", "\"\<20 \[Degree]C\>\"", ",", 
                "\"\<22 \[Degree]C\>\""}], "}"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
             "PlotLabel", "->", "\"\<Potrebna mo\[CHacek] ogrevanja\>\""}], 
             ",", "\[IndentingNewLine]", 
             RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"grafOdstotkov", "=", 
           RowBox[{"BarChart", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"t20", "-", "t18"}], ")"}], "/", "t18"}], ")"}], 
                "*", "100"}], ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"t22", "-", "t18"}], ")"}], "/", "t18"}], ")"}], 
                "*", "100"}]}], "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{"ChartLabels", "->", 
              RowBox[{"{", 
               RowBox[{
               "\"\<20 \[Degree]C\>\"", ",", "\"\<22 \[Degree]C\>\""}], 
               "}"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{
             "PlotLabel", "->", "\"\<Pove\[CHacek]anje porabe [%]\>\""}], ",",
              "\[IndentingNewLine]", 
             RowBox[{"LabelingFunction", "->", "Above"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tabela", "=", 
           RowBox[{"Grid", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
